{
  "name": "karkascrm",
  "version": "1.0.0",
  "private": true,
  "description": "КаркасCRM — сделки и воронки, клиенты, задачи, единый инбокс мессенджеров, почта и разведка конкурентов. Без внешних зависимостей, один контейнер.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite backend/src/server.js",
    "dev": "DATA_DIR=./data node --experimental-sqlite backend/src/server.js",
    "test": "node --experimental-sqlite --test tests/api.test.js tests/competitors.test.js tests/notifications.test.mjs tests/db-hygiene.test.mjs",
    "test:db": "node --experimental-sqlite --test tests/db-hygiene.test.mjs tests/migrate.test.mjs",
    "test:ui": "node --experimental-sqlite tests/ui.smoke.mjs",
    "test:all": "./run-tests.sh",
    "start:local": "./run-local.sh",
    "check": "node --check backend/src/server.js && node --check backend/src/competitors.js && node --check backend/src/smtp.js && node --check frontend/public/app.js",
    "test:notify": "node --experimental-sqlite --test tests/notifications.test.mjs",
    "db:check": "node --experimental-sqlite scripts/db-check.mjs",
    "db:clean": "node --experimental-sqlite scripts/db-check.mjs --clean"
  }
}
