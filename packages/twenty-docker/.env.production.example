# ---------------------------------
# Image
# ---------------------------------
TAG=latest

# ---------------------------------
# Public URL
# ---------------------------------
# Local (no TLS profile): http://crm.example.com:3000
# TLS profile: https://crm.example.com
SERVER_URL=https://crm.example.com

# Used by docker-compose.tls.yml profile
DOMAIN_NAME=crm.example.com
ACME_EMAIL=admin@example.com

# ---------------------------------
# Database / Redis
# ---------------------------------
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_with_strong_password_without_special_characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://redis:6379

# ---------------------------------
# Security / secrets
# ---------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_base64_32_bytes
# Keep empty unless rotating
FALLBACK_ENCRYPTION_KEY=
# Legacy fallback for old instances only
APP_SECRET=

# ---------------------------------
# Storage (recommended: S3-compatible in production)
# ---------------------------------
STORAGE_TYPE=S_3
STORAGE_S3_REGION=eu-west-1
STORAGE_S3_NAME=replace_with_bucket_name
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=replace_with_access_key
STORAGE_S3_SECRET_ACCESS_KEY=replace_with_secret_key

# ---------------------------------
# Authentication providers (optional)
# ---------------------------------
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://crm.example.com/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.example.com/auth/google-apis/get-access-token

AUTH_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_CALLBACK_URL=https://crm.example.com/auth/microsoft/redirect
AUTH_MICROSOFT_APIS_CALLBACK_URL=https://crm.example.com/auth/microsoft-apis/get-access-token

# Gmail / Calendar integrations
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# ---------------------------------
# SMTP (optional)
# ---------------------------------
EMAIL_FROM_ADDRESS=contact@example.com
EMAIL_FROM_NAME=CRM Team
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---------------------------------
# Platform modes
# ---------------------------------
# true (default): configure most variables via Admin Panel
# false: full env-only mode
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true
IS_MULTIWORKSPACE_ENABLED=false

# Optional hardening switches
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
