# KarkasCRM — скопируйте в .env:  cp .env.example .env
# Быстрый старт: ./install.sh  (сам сгенерирует секреты) или: docker compose up -d --build
# Домен с HTTPS: ./install.sh --tls ваш-домен.ru mail@ваш-домен.ru
# Без Docker (проверка на своём компьютере): ./run-local.sh

# ── Основное ──────────────────────────────────────────────
# Внешний порт, по которому открывается CRM
CRM_PORT=8080
# На каком адресе слушать: 0.0.0.0 — доступ с других машин (локальный запуск),
# 127.0.0.1 — только с самого сервера (правильно вместе с доменом и HTTPS, профиль tls)
CRM_BIND=0.0.0.0
# Часовой пояс контейнера (влияет на даты в отчётах и время резервных копий)
TZ=Europe/Moscow

# ── Домен и HTTPS (профиль tls: docker compose --profile tls up -d --build) ──
# Домен, A-запись которого указывает на IP сервера. Нужен для вебхуков мессенджеров.
# При этом CRM_BIND выше поставьте в 127.0.0.1 — наружу пусть смотрит только Caddy.
# Проще всего: ./install.sh --tls ваш-домен.ru mail@ваш-домен.ru
CRM_DOMAIN=
# E-mail для сертификата Let's Encrypt (Caddy): уведомления об истечении
ACME_EMAIL=
# ПОДПИСЬ ТОКЕНОВ ВХОДА — обязательно замените на случайную строку 32+ символа:
#   openssl rand -hex 32
JWT_SECRET=СМЕНИТЕ-на-длинную-случайную-строку-минимум-32-символа

# ── Первый администратор (создаётся при первом запуске) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ── Wazzup: WhatsApp, Telegram, Instagram, Viber ─────────
# Ключ: ЛК Wazzup → Интеграция с CRM → API → Подключить.
# Можно оставить пустым и вписать в интерфейсе: Настройки → Интеграции и каналы.
WAZZUP_API_KEY=
# Канал по умолчанию (можно не указывать — выбирается при синхронизации каналов)
WAZZUP_CHANNEL_ID=
# Секрет вебхука: тогда адрес для Wazzup — https://домен/webhooks/wazzup?secret=ЗНАЧЕНИЕ
WAZZUP_WEBHOOK_SECRET=
# Базовый URL API Wazzup (менять не нужно)
WAZZUP_API_URL=https://api.wazzup24.com/v3

# ── Прямой WhatsApp Cloud API (Meta) — если Wazzup не нужен ──
# Провайдер переключается в интерфейсе: Настройки → Интеграции
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=karkas-verify

# ── Свой Telegram-бот (необязательно) ────────────────────
TELEGRAM_BOT_TOKEN=

# ── Вкладка «Конкуренты»: ключи источников (необязательно) ──
# Без ключей вкладка работает по ссылкам ручной проверки; с ключами данные подтягиваются автоматически.
# Задать можно и в интерфейсе: Настройки → Конкуренты и источники
# api-fns.ru — ЕГРЮЛ, недоимки, руководители
FNS_API_KEY=
# api-ip.fssprus.ru — исполнительные производства и суммы долгов
FSSP_TOKEN=
# Google Places — рейтинг, число и тексты отзывов
GOOGLE_PLACES_KEY=
# 2GIS Places — рейтинг и число отзывов
TWOGIS_KEY=
# Яндекс Геопоиск — карточки организаций, адреса, телефоны
YANDEX_API_KEY=

# ── Почта: письма клиентам из CRM и приём входящих ───────
# Всё то же самое настраивается в интерфейсе: Настройки → Интеграции → Почта.
# Примеры SMTP: smtp.yandex.ru:465 (SSL), smtp.mail.ru:465, smtp.gmail.com:587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
# 1 — SSL/TLS сразу (обычно порт 465), 0 — без шифрования (внутренний релей), пусто — STARTTLS если сервер умеет
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Адрес отправителя (обычно совпадает с SMTP_USER)
MAIL_FROM=
# Секрет вебхука входящих писем: адрес для пересылки — https://домен/webhooks/email?secret=ЗНАЧЕНИЕ
EMAIL_WEBHOOK_SECRET=

# ── Обслуживание ─────────────────────────────────────────
# План продаж на месяц — можно задать и в интерфейсе (Аналитика → План продаж)
SALES_TARGET=0
# Автосоздание сделки при обращении: 1 — создавать сделку в «Неразобранном», 0 — не создавать
AUTO_DEAL=1
# Распределять новые обращения между менеджерами: 1 — наименее загруженному, 0 — без ответственного
AUTO_ASSIGN=0
# Резервные копии: сколько дней хранить и в котором часу делать (копии в /data/backups)
BACKUP_KEEP_DAYS=7
BACKUP_HOUR=3
# Webhook уведомлений о просроченных задачах (Slack/Telegram-бот/свой сервис) — необязательно
NOTIFY_WEBHOOK=
# Строже защита входа: число попыток за 5 минут с одного IP
LOGIN_RATE_LIMIT=12
# Встраивание CRM в iframe (например, "*" или https://ваш-портал.ru) — по умолчанию выключено
FRAME_ANCESTORS=
