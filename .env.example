# KarkasCRM — скопируйте в .env:  cp .env.example .env
# Быстрый старт: ./install.sh (сам сгенерирует секреты) или: docker compose up -d --build
# Домен с HTTPS: ./install.sh --tls ваш-домен.ru mail@ваш-домен.ru
#
# ВАЖНО: всё, что меняется в интерфейсе CRM («Настройки»), хранится в базе и
# ПЕРЕКРЫВАЕТ значения из .env. Здесь — только то, что нужно для запуска,
# деплоя и первого входа. Интеграции и поведение настраиваются в CRM.

# ── Основное ──────────────────────────────────────────────
# Внешний порт, по которому открывается CRM
CRM_PORT=8080
# На каком адресе слушать: 0.0.0.0 — доступ с других машин (локальный запуск / по IP),
# 127.0.0.1 — только с самого сервера (правильно вместе с доменом и HTTPS, профиль tls)
CRM_BIND=127.0.0.1
# Часовой пояс контейнера (даты в отчётах, время резервных копий)
TZ=Europe/Moscow

# ── Начальные данные (SEED_MODE) ─────────────────────────
# demo — примеры для знакомства (локальный запуск); base — чистый старт для работы:
# каталог, личные шаблоны администратора и пример правила (прод); off — совсем пусто.
# Пусто = авто: без CRM_DOMAIN — demo, с доменом — base.
# Демо-данные потом удаляются кнопкой «Настройки → Данные и компания».
SEED_MODE=

# ── Домен и HTTPS (профиль tls: docker compose --profile tls up -d --build) ──
# Домен, A-запись которого указывает на IP сервера. Нужен для вебхуков мессенджеров.
# При этом CRM_BIND выше поставьте в 127.0.0.1 — наружу смотрит только Caddy.
# Проще всего: ./install.sh --tls ваш-домен.ru mail@ваш-домен.ru
CRM_DOMAIN=
# E-mail для сертификата Let's Encrypt (Caddy): уведомления об истечении
ACME_EMAIL=
# ПОДПИСЬ ТОКЕНОВ ВХОДА — обязательно замените на случайную строку 32+ символа:
#   openssl rand -hex 32
JWT_SECRET=СМЕНИТЕ-на-длинную-случайную-строку-минимум-32-символа

# ── Необязательные тонкие настройки ─────────────────────
# Свой файл логотипа (путь внутри контейнера; проще загрузить логотип в интерфейсе:
# Настройки → Данные и компания). Пример — смонтировать файл в compose.
LOGO_FILE=
# 1 — разрешить проверке конкурентов ходить на локальные адреса (нужно только
# для внутренних шлюзов и тестов; по умолчанию закрыто — защита от SSRF)
ALLOW_PRIVATE_FETCH=
# 1 — не создавать начальные данные вообще (база останется пустой)
KARKAS_NO_SEED=

# ── Первый администратор (создаётся при первом запуске) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ── Wazzup: WhatsApp, Telegram, Instagram и Viber в одном ключе ──
# Ключ: ЛК Wazzup → Интеграция с CRM → API → Подключить.
# Можно оставить пустым и вписать в интерфейсе: Настройки → Интеграции и каналы.
WAZZUP_API_KEY=
# Секрет вебхука: тогда адрес для Wazzup — https://домен/webhooks/wazzup?secret=ЗНАЧЕНИЕ
WAZZUP_WEBHOOK_SECRET=

# ── Почта: письма клиентам из CRM и приём входящих ───────
# То же самое настраивается в интерфейсе: Настройки → Интеграции → Почта.
# Примеры SMTP: smtp.yandex.ru:465 (SSL), smtp.mail.ru:465, smtp.gmail.com:587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
# 1 — SSL/TLS сразу (обычно порт 465), 0 — без шифрования (внутренний релей),
# пусто — STARTTLS, если сервер умеет
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Адрес отправителя (обычно совпадает с SMTP_USER)
MAIL_FROM=
# 1 — не проверять сертификат SMTP (только внутренний релей с самоподписанным сертификатом)
SMTP_TLS_INSECURE=
# Секрет вебхука входящих писем: адрес для пересылки — https://домен/webhooks/email?secret=ЗНАЧЕНИЕ
EMAIL_WEBHOOK_SECRET=
