# Переменные окружения: .env в репозиторий не попадает
**/.env
!.env.example

# База данных и резервные копии (живут в томе Docker или в ./data локально)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite

# Служебное
**/node_modules/
.DS_Store
*.log
logs/
coverage/
test-results/
.tmp/
/downloads/
/frontend/public/downloads/
*.zip
*.patch

# Перенос на другой сервер: архив с данными, страховочные копии, saved .env и
# рабочие каталоги. В архиве база и секреты, поэтому в репозиторий им нельзя.
karkascrm-move-*.tar.gz
pre-move-*.tar.gz
.env.pre-move-*
.karkas-move.*/
